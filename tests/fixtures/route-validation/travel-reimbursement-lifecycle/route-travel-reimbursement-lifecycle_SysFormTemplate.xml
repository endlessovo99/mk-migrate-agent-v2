    function changeBsegValue() {
      var firstCostCenterVal = getFormFieldValue(&quot;fd_bseg_firstkostl&quot;);
      var secondCostCenter = $(&quot;select[name=extendDataFormInfo.value(fd_bseg_kostl)]&quot;);
      secondCostCenter.empty();
      secondCostCenter.append(&quot;&lt;option value=&amp;apos;&amp;apos;&gt;Select&lt;/option&gt;&quot;);
      if (firstCostCenterVal == &quot;A&quot;) {
        secondCostCenter.append(&quot;&lt;option value=&amp;apos;ROUTE_CC_A&amp;apos;&gt;Route Cost Center A&lt;/option&gt;&quot;);
      } else if (firstCostCenterVal == &quot;B&quot;) {
        secondCostCenter.append(&quot;&lt;option value=&amp;apos;ROUTE_CC_B&amp;apos;&gt;Route Cost Center B&lt;/option&gt;&quot;);
      }
    }

    AttachXFormValueChangeEventById(&quot;fd_bseg_firstkostl&quot;, changeBsegValue);

    AttachXFormValueChangeEventById(&quot;fd_bseg_kostl&quot;, function(value, domElement) {
      if (theFinanceObj) {
