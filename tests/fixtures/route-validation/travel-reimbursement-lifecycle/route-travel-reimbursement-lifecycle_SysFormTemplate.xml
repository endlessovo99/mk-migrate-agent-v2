      }
    });
   &lt;/script&gt;&lt;/xform:editShow&gt;&apos;/&gt;&lt;/div&gt;

   &lt;div id=&quot;fd_3bc187ead08638&quot; fd_type=&quot;jsp&quot;&gt;&lt;input type=&quot;hidden&quot; value=&apos;&lt;xform:editShow&gt;&lt;script&gt;
    function trafficCityChange() {
      var fdOvernightDays = $(&quot;[name=extendDataFormInfo.value(fd_overnight_days)]&quot;);
      var fdAllowanceDays = $(&quot;[name=extendDataFormInfo.value(fd_allowance_days)]&quot;);
      var allowanceCHG = $(&quot;[name=extendDataFormInfo.value(fd_allowance_chg)]&quot;);
      var everydayAllowance = $(&quot;[name=extendDataFormInfo.value(fd_everyday_allowance)]&quot;);
      if (theCityFlag == 0) {
        fdOvernightDays.val(0);
        fdAllowanceDays.val(0);
        allowanceCHG.val(0.00);
        everydayAllowance.val(20);
        allowanceCalBG();
      } else {
        everydayAllowance.val(100);
        trafficOvernightDays();
        allowanceCalBG();
      }
      receiptTotal();
    }
   &lt;/script&gt;&lt;/xform:editShow&gt;&apos;/&gt;&lt;/div&gt;

   &lt;div id=&quot;fd_3cc25d96ee0df2&quot; fd_type=&quot;jsp&quot;&gt;&lt;input type=&quot;hidden&quot; value=&apos;&lt;xform:editShow&gt;&lt;script&gt;
    var payeeListTableId = &quot;fd_payee_list&quot;;
    var totalPayId = &quot;fd_total_cost&quot;;

    function payeeListCal(tableId, controlId) {
      var tab_id = &quot;TABLE_DL_&quot; + tableId;
      var tbInfo = DocList_TableInfo[tab_id];
      var sum = 0;
      if (typeof (tbInfo) != &quot;undefined&quot;) {
        for (var i = 0; i &lt; tbInfo.lastIndex - 1; i++) {
          var clild_id = tableId + &quot;.&quot; + i + &quot;.&quot; + controlId;
          var current_inspire = $(&quot;[name=extendDataFormInfo.value(&quot; + clild_id + &quot;)]&quot;).val();
          sum = theFixedNumTwo(sum + Number(current_inspire));
        }
      }
      return sum;
    }

    function payeeListSum() {
      var payeeListRowAmount = &quot;fd_payee_amount&quot;;
      var sum = payeeListCal(payeeListTableId, &quot;fd_payee_amount&quot;);
      var payeeTotalVal = $(&quot;[name=extendDataFormInfo.value(fd_payee_total)]&quot;);
      payeeTotalVal.val(sum);
      var fd_total_pay = getFormFieldValue(totalPayId);
      var payeeDiffVal = $(&quot;[name=extendDataFormInfo.value(fd_payee_diff)]&quot;);
      var diffAmount = sum - Number(fd_total_pay);
      payeeDiffVal.val(diffAmount);
      payeeDiffTip(diffAmount);
    }
   &lt;/script&gt;&lt;/xform:editShow&gt;&apos;/&gt;&lt;/div&gt;

   &lt;div id=&quot;fd_3cc17629476baa&quot; fd_type=&quot;jsp&quot;&gt;&lt;input type=&quot;hidden&quot; value=&apos;&lt;script&gt;
    var theCityFlag = 1;
    var theFlagNo = 0;
    var theConstFiaSaveFlag = 2222;
   &lt;/script&gt;&lt;xform:editShow&gt;&lt;script&gt;
    AttachXFormValueChangeEventById(&quot;fd_3cc1757848e700&quot;, function(value, domElement) {
      var isCityFlag = GetXFormFieldById(&quot;fd_the_city_flag&quot;)[0];
      if (value == &quot;1&quot;) {
        theCityFlag = 1;
        isCityFlag.value = &quot;1&quot;;
        common_dom_row_set_show_required_reset(&quot;fd_guonei_row&quot;, true, true, false);
      } else {
        theCityFlag = 0;
        isCityFlag.value = &quot;0&quot;;
        clearTrainData();
        common_dom_row_set_show_required_reset(&quot;fd_guonei_row&quot;, false, false, false);
      }
      trafficCityChange();
    });

    AttachXFormValueChangeEventById(&quot;fd_396238f4339462&quot;, function(value, domElement) {
      if (value.length &gt; 1) {
        setDepartMentSelect(value[1]);
      }
    });

    function clearTrainData() {
      var trafficCityDetailTableId = &quot;fd_trafficCity_detail&quot;;
      _DocList_AddRows(trafficCityDetailTableId, [{}]);
      trafficCityDetailTableId = &quot;fd_train_detail&quot;;
      _DocList_AddRows(trafficCityDetailTableId, [{}]);
      trafficCityDetailTableId = &quot;fd_flight_detail&quot;;
      _DocList_AddRows(trafficCityDetailTableId, [{}]);
    }

    function setDepartMentSelect(tempDepart) {
      var fd_departmentID = &quot;fd_bseg_firstkostl&quot;;
      var fd_department_arr = $(&quot;#route-first-cost-center option&quot;);
      for (var index = 0; index &lt; fd_department_arr.length; index++) {
        var element = fd_department_arr[index];
        var findIndex = tempDepart.indexOf(element.text);
        if (findIndex &gt;= 0) {
          var fd_depOldVal = getFormFieldValue(&quot;fd_bseg_firstkostl&quot;);
          if (fd_depOldVal != element.value) {
            SetXFormFieldValueById(fd_departmentID, element.value);
            changeBsegValue();
          }
          break;
        }
      }
    }

    Com_AddEventListener(window, &quot;load&quot;, function() {
      theFlagNo = Number(GetXFormFieldById(&quot;fd_flag_save_no&quot;)[0].value);
      if (typeof theFinanceFlag != &quot;undefined&quot;) {
      } else {
        if (theConstFiaSaveFlag == theFlagNo) {
          SetXFormFieldValueById(&quot;fd_voucher_no&quot;, &quot;&quot;);
          SetXFormFieldValueById(&quot;fd_voucher_msg&quot;, &quot;&quot;);
          SetXFormFieldValueById(&quot;fd_link_address&quot;, &quot;&quot;);
          _DocList_AddRows(&quot;fd_finance_detail&quot;, [{}]);
        }
      }

      theCityFlag = Number(getFormRadioValue(&quot;fd_3cc1757848e700&quot;));
      if (theCityFlag == 0) {
        common_dom_row_set_show_required_reset(&quot;fd_guonei_row&quot;, false, false, false);
      }

      var fd_department = getFormFieldValue(&quot;fd_396238f4339462&quot;);
      var fd_depOldVal = getFormFieldValue(&quot;fd_bseg_firstkostl&quot;);
      if (fd_department.length &gt; 1 &amp;&amp; (fd_depOldVal == undefined || fd_depOldVal == &quot;&quot;)) {
        setDepartMentSelect(fd_department[1]);
      }
    });

    Com_Parameter.event[&quot;submit&quot;].push(function() {
      if (GetXFormFieldById(&quot;fd_is_project&quot;)[0].value == &quot;1&quot;) {
        var projectNumListTableId = &quot;fd_project_num_list&quot;;
        var wbsData = commonWBSStr;
        var wbsList = _DocList_FormFieldValue(projectNumListTableId, &quot;fd_bseg_projk&quot;);
        var errorFlag = false;
        var wbsMsg = &quot;&quot;;
        if (wbsList) {
          for (var i = 0; i &lt; wbsList.length; i++) {
            if (wbsData.indexOf(wbsList[i]) &lt; 0) {
              wbsMsg = wbsMsg + &quot;,&quot; + (i + 1);
              errorFlag = true;
            }
          }
        }
        if (errorFlag) {
          alert(&quot;Invalid project code rows: &quot; + wbsMsg);
          return false;
        }
      }

      var getPayeeTableId = &quot;fd_payee_list&quot;;
      var tempPayeeList = _DocList_FormFieldValue(getPayeeTableId, &quot;fd_card_number&quot;);
      errorFlag = false;
      var payeeMsg = &quot;&quot;;
      if (tempPayeeList) {
        for (var i = 0; i &lt; tempPayeeList.length; i++) {
          if (tempPayeeList[i].length &lt; 16) {
            payeeMsg = payeeMsg + &quot;,&quot; + (i + 1);
            errorFlag = true;
          }
        }
      }
      if (errorFlag) {
        alert(&quot;Invalid card number rows: &quot; + payeeMsg);
        return false;
      }

      payeeListSum();
      var $tempObj = $(&quot;input[name=extendDataFormInfo.value(fd_payee_diff)]&quot;);
      if (Number($tempObj.val()) != 0) {
        alert(&quot;Payee total must equal total cost.&quot;);
        return false;
      }

      if (typeof theFinanceFlag != &quot;undefined&quot;) {
        theFlagNo = theConstFiaSaveFlag;
      } else {
        theFlagNo = theFlagNo + 1;
      }
      SetXFormFieldValueById(&quot;fd_flag_save_no&quot;, theFlagNo);
      return true;
    });
   &lt;/script&gt;&lt;/xform:editShow&gt;&apos;/&gt;&lt;/div&gt;

   &lt;div id=&quot;fd_3cd39a8bc880b0&quot; fd_type=&quot;jsp&quot;&gt;&lt;input type=&quot;hidden&quot; value=&apos;&lt;xform:editShow&gt;&lt;script&gt;
    function theFixedNumTwo(value) {
      var precision = 2;
      var power = Math.pow(10, precision);
      return Math.round(value * power) / power;
    }
   &lt;/script&gt;&lt;/xform:editShow&gt;&apos;/&gt;&lt;/div&gt;

