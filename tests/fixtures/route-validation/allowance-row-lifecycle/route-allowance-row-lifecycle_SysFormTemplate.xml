  var sum = 0;
  for (var i = 0; i &amp;lt; tableInfo.lastIndex - 1; i++) {
    var rowId = tableId + &amp;quot;.&amp;quot; + i + &amp;quot;.&amp;quot; + controlId;
    var amount = $(&amp;quot;[name=extendDataFormInfo.value(&amp;quot; + rowId + &amp;quot;)]&amp;quot;).val();
    sum = theFixedNumTwo(sum + Number(amount));
  }
  return sum;
}
function trafficDays() {
  var days = timeDifference(&amp;quot;fd_trip_start&amp;quot;, &amp;quot;fd_trip_end&amp;quot;);
