}
function timeDifference(startId, endId) {
  var start = new Date(getFormFieldValue(startId));
  var end = new Date(getFormFieldValue(endId));
  start.setHours(0, 0, 0, 0);
  end.setHours(0, 0, 0, 0);
  return Math.floor((end.getTime() - start.getTime()) / 86400000);
}
function receiptAllowanceCap() {
